# Requisições que não passam pelo cliente supabase-js (ex: <img src> apontando
# para uma public URL do Storage) chegam sem o header apikey. O Kong da
# Supabase hospedada injeta a anon key nesse caso; aqui replicamos isso sem
# sobrescrever um apikey (service role, por exemplo) que já tenha sido enviado.
map $http_apikey $proxied_apikey {
    default $http_apikey;
    ""      "${ANON_KEY}";
}

server {
    listen 8000;
    listen [::]:8000;
    server_tokens off;

    # Tamanho máximo de upload (storage): 55MB
    client_max_body_size 55m;

    # ---- Autenticação (GoTrue) ----
    location /auth/v1/ {
        proxy_pass         http://auth:9999/;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   apikey            $proxied_apikey;

        proxy_hide_header  Access-Control-Allow-Origin;
        proxy_hide_header  Access-Control-Allow-Headers;
        proxy_hide_header  Access-Control-Allow-Methods;
        proxy_hide_header  Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin  * always;
        add_header Access-Control-Allow-Headers "Authorization,apikey,content-type,x-client-info,x-supabase-api-version,x-retry-count,accept-profile,content-profile" always;
        add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
        if ($request_method = OPTIONS) { return 204; }
    }

    # ---- API REST (PostgREST) ----
    location /rest/v1/ {
        proxy_pass         http://rest:3000/;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   apikey            $proxied_apikey;

        proxy_hide_header  Access-Control-Allow-Origin;
        proxy_hide_header  Access-Control-Allow-Headers;
        proxy_hide_header  Access-Control-Allow-Methods;
        proxy_hide_header  Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin  * always;
        add_header Access-Control-Allow-Headers "Authorization,apikey,content-type,range,prefer,x-client-info,x-supabase-api-version,x-retry-count,accept-profile,content-profile" always;
        add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
        if ($request_method = OPTIONS) { return 204; }
    }

    # ---- Realtime (WebSocket) ----
    location /realtime/v1/ {
        proxy_pass             http://realtime:4000/socket/;
        proxy_http_version     1.1;
        proxy_set_header       Upgrade    $http_upgrade;
        proxy_set_header       Connection "upgrade";
        proxy_set_header       Host       $host;
        proxy_set_header       apikey     $proxied_apikey;
        proxy_read_timeout     86400s;
        proxy_send_timeout     86400s;

        proxy_hide_header  Access-Control-Allow-Origin;
        proxy_hide_header  Access-Control-Allow-Headers;
        proxy_hide_header  Access-Control-Allow-Methods;
        proxy_hide_header  Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin  * always;
        add_header Access-Control-Allow-Headers "Authorization,apikey,x-client-info,x-supabase-api-version,x-retry-count" always;
    }

    # ---- Storage (arquivos e fotos) ----
    location /storage/v1/ {
        proxy_pass              http://storage:5000/;
        proxy_set_header        Host              $host;
        proxy_set_header        X-Real-IP         $remote_addr;
        proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header        apikey            $proxied_apikey;
        proxy_request_buffering off;

        proxy_hide_header  Access-Control-Allow-Origin;
        proxy_hide_header  Access-Control-Allow-Headers;
        proxy_hide_header  Access-Control-Allow-Methods;
        proxy_hide_header  Access-Control-Allow-Credentials;
        add_header Access-Control-Allow-Origin  * always;
        add_header Access-Control-Allow-Headers "Authorization,apikey,content-type,x-client-info,x-upsert,x-supabase-api-version,x-retry-count,accept-profile,content-profile" always;
        add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
        if ($request_method = OPTIONS) { return 204; }
    }
}
